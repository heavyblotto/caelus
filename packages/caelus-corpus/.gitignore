node_modules/
dist/
*.tgz

# Vale prose extract, regenerated by the root scripts/extract-web-prose.mjs
.web-prose-extract.md

# Vale's downloaded style packages; the vendored copies under
# editorial/styles/ are what CI uses.
editorial/styles/.vale-cache/

# essay embeddings: the parquet is regenerable by pipeline/embeddings/embed.py
# and large; neighbors.json and embeddings_manifest.json stay tracked.
artifacts/embeddings/*.parquet
# uv virtualenv for the embeddings pipeline
pipeline/embeddings/.venv/
pipeline/embeddings/__pycache__/
