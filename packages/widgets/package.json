{
  "name": "caelus-widgets",
  "version": "0.24.1",
  "description": "Encyclopedia widgets for caelus: interactive figures whose resting render is the plate. Every widget is a pure function of a serializable { kind, params } spec.",
  "type": "module",
  "private": true,
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
