{
  "name": "caelus-mcp",
  "version": "0.25.0",
  "mcpName": "io.github.heavyblotto/caelus-mcp",
  "description": "MCP server for Caelus astrology computation: charts, transits, timing techniques, Vedic methods, and citable chart facts.",
  "type": "module",
  "bin": {
    "caelus-mcp": "dist/src/server.js"
  },
  "main": "dist/src/server.js",
  "types": "dist/src/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/server.d.ts",
      "default": "./dist/src/server.js"
    },
    "./core": {
      "types": "./dist/src/core.d.ts",
      "default": "./dist/src/core.js"
    },
    "./dist/src/server.js": "./dist/src/server.js",
    "./dist/src/core.js": "./dist/src/core.js",
    "./data/gazetteer.json": "./data/gazetteer.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^3.24.0",
    "caelus": "^0.25.0"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist/src",
    "data/gazetteer.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heavyblotto/caelus.git",
    "directory": "packages/caelus-mcp"
  },
  "homepage": "https://ephemengine.com",
  "keywords": [
    "astrology",
    "ephemeris",
    "mcp",
    "model-context-protocol",
    "natal-chart"
  ]
}
