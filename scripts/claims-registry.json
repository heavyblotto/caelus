{
  "_doc": "Each claim ties a number/string that appears in prose to a generated source of truth. check-claims.mjs verifies the rendered value is present in every listed file and that no competing value of the same shape appears. Sources: 'stats' = conformance-stats.json (golden suite), 'accuracy' = packages/caelus/accuracy.json, 'bundles' = bundle-sizes.json (esbuild measurements), 'data' = raw data files (terminal #keys counts object keys). Dynamic TSX pages import apps/web/lib/facts.ts formatters; literal anchors live in facts-anchors.generated.ts (scripts/sync-facts.mjs). PATCHES.md is intentionally excluded everywhere: it is a historical changelog that records superseded values on purpose. ROADMAP.md is likewise excluded from competing-value checks: its decision log records the state at past milestones (e.g. older tool counts).",
  "claims": [
    {
      "id": "golden-check-count",
      "source": "stats.checks",
      "render": [
        "{value}"
      ],
      "competing": "\\b\\d,\\d{3}\\b(?=[^\\n]{0,40}(golden|check|fixture))",
      "appearsIn": [
        "ARCHITECTURE.md",
        "apps/web/lib/facts-anchors.generated.ts",
        "apps/web/public/llms.txt",
        "llms.txt",
        "packages/caelus/README.md"
      ],
      "format": "thousands"
    },
    {
      "id": "worst-diff-nano-prose",
      "source": "stats.worst.nano_arcsec",
      "round": 2,
      "render": [
        "{value} nano-arcsecond"
      ],
      "competing": "(\\d+\\.\\d+)\\s*nano-arcsecond",
      "appearsIn": [
        "packages/caelus/README.md",
        "apps/web/lib/facts-anchors.generated.ts"
      ]
    },
    {
      "id": "worst-diff-nano-llms",
      "source": "stats.worst.nano_arcsec",
      "round": 2,
      "render": [
        "{value}e-9 arcsec"
      ],
      "competing": "(\\d+\\.\\d+)e-9 arcsec",
      "appearsIn": [
        "apps/web/public/llms.txt",
        "llms.txt"
      ]
    },
    {
      "id": "true-node-bound",
      "source": "accuracy.true_node_vs_builtin",
      "render": [
        "true node \u2264 {value}",
        "true node <= 1'"
      ],
      "competing": "true node [\u2264<=]+ ?1[\u2033\\\"]",
      "appearsIn": [
        "packages/caelus/README.md",
        "MCP_SPEC.md",
        "packages/caelus-mcp/src/server.ts",
        "llms.txt",
        "apps/web/public/llms.txt"
      ]
    },
    {
      "id": "house-system-count",
      "source": "accuracy.counts.house_systems",
      "render": [
        "{value} house systems",
        "{value} systems",
        "twelve house systems",
        "Twelve house systems"
      ],
      "appearsIn": [
        "apps/web/lib/facts-anchors.generated.ts",
        "apps/web/app/docs/data-tiers/page.mdx",
        "python/README.md"
      ]
    },
    {
      "id": "sidereal-ayanamsa-count",
      "source": "accuracy.counts.sidereal_ayanamsas",
      "render": [
        "{value} sidereal",
        "{value} ayanamsas",
        "seven sidereal",
        "seven ayanamsas"
      ],
      "competing": "(\\b\\d+|six|seven|eight|nine|ten|eleven|twelve) (sidereal|ayanamsa)",
      "appearsIn": [
        "apps/web/lib/facts-anchors.generated.ts",
        "apps/web/app/docs/data-tiers/page.mdx",
        "ROADMAP.md",
        "python/README.md"
      ]
    },
    {
      "id": "headline-range",
      "source": "accuracy.range",
      "render": [
        "{value}",
        "1000–3000",
        "1000&ndash;3000"
      ],
      "appearsIn": [
        "packages/caelus/src/ranges.ts",
        "llms.txt",
        "apps/web/public/llms.txt",
        "apps/web/app/docs/data-tiers/page.mdx",
        "apps/web/app/docs/edge-cases/page.mdx",
        "apps/web/components/FAQ.tsx",
        "apps/web/app/features/page.tsx",
        "apps/web/app/validation/page.tsx",
        "packages/caelus/README.md"
      ]
    },
    {
      "id": "fixed-star-count",
      "source": "data.fixed_stars.stars#keys",
      "render": [
        "{value} fixed stars",
        "{value}-star"
      ],
      "competing": "\\b3\\d\\d fixed stars\\b|\\b3\\d\\d-star",
      "appearsIn": [
        "apps/web/app/features/page.tsx",
        "apps/web/app/docs/data-tiers/page.mdx",
        "llms.txt",
        "apps/web/public/llms.txt"
      ]
    },
    {
      "id": "embedded-bundle-gzip",
      "source": "bundles.embedded.gzipKb",
      "round": 0,
      "render": [
        "~{value} KB"
      ],
      "competing": "~([5-9]\\d|1[0-4]\\d) KB(?=[^\\n]{0,30}(total|gz))",
      "appearsIn": [
        "apps/web/app/page.tsx",
        "apps/web/app/docs/data-tiers/page.mdx",
        "llms.txt",
        "apps/web/public/llms.txt",
        "packages/caelus/README.md"
      ]
    },
    {
      "id": "wheel-bundle-gzip",
      "source": "bundles.wheel.gzipKb",
      "round": 1,
      "render": [
        "~{value} KB"
      ],
      "competing": "~[3-9](\\.\\d)? KB\\b",
      "appearsIn": [
        "apps/web/app/page.tsx"
      ]
    },
    {
      "id": "mcp-tool-count",
      "source": "accuracy.counts.mcp_tools",
      "render": [
        "{value} chart tools",
        "{value} MCP tools",
        "MCP tools ({value})",
        "{value}-tool",
        "{value} tools",
        "thirty-five chart tools",
        "Thirty-five chart tools",
        "thirty-five tools"
      ],
      "competing": "(twenty|thirty|forty|fifty)-[a-z]+[^a-z\\n]{0,12}tools\\b|\\b\\d{2}[^0-9\\n]{0,12}(chart |MCP )?tools\\b|\\b\\d{2}-tool\\b",
      "appearsIn": [
        "apps/web/lib/facts-anchors.generated.ts",
        "apps/web/app/docs/mcp/page.mdx",
        "llms.txt",
        "apps/web/public/llms.txt",
        "packages/caelus-mcp/README.md",
        "packages/caelus/README.md",
        "packages/wheel/README.md",
        "packages/birth/README.md",
        "packages/caelus-mcp/server.json"
      ]
    },
    {
      "id": "default-body-count",
      "source": "accuracy.counts.default_bodies",
      "render": [
        "{value} bodies",
        "Thirteen in the default"
      ],
      "appearsIn": [
        "apps/web/lib/facts-anchors.generated.ts",
        "MCP_SPEC.md",
        "packages/caelus-mcp/README.md"
      ]
    }
  ]
}
