# dependencies
node_modules/

# build outputs
dist/
# generated image renders (SkyView test/demo output)
output/
apps/web/.next/
apps/web/.next-ci/
apps/web/out/
# auto-generated by `next build`; its <reference> path flips with NEXT_DIST_DIR
apps/web/next-env.d.ts
# generated by scripts/build-search-index.mjs at build time
apps/web/public/search-index.json

# env
.env
.env.*
!.env.example

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# archives and extracted copies (monorepo is the source of truth)
*.zip
extracted/

# python fitting caches (Horizons samples committed for Chiron reproducibility)
python/__pycache__/
.web-prose-extract.md
python/astroengine/__pycache__/

# python packaging artifacts (caelus-engine on PyPI; dists built on demand)
python/build/
python/dist/
python/*.egg-info/

# private strategy / roadmap docs — never commit to this public repo
STRATEGY.md
STRATEGY*.md

# MCP Registry CLI — per-machine download (see docs/releasing.md), never committed
mcp-publisher

# logs
*.log
npm-debug.log*

# generated conformance stats (regenerated by the golden suite for lint:claims)
conformance-stats.json
# measured bundle sizes (regenerated by scripts/bundle-sizes.mjs for lint:claims)
bundle-sizes.json
*.tsbuildinfo

# per-run eval reports are scratch (regenerated by every live model run);
# the committed record is eval/baselines/<date>-<model>.{json,md}, written by
# eval/baseline.mjs -- the dated, scored answer to "do hosts pick the right
# tool?" that the docs and release process quote.
packages/caelus-mcp/eval/report.json
packages/caelus-mcp/eval/report.md
python/moon_horizons_cache.json
# Wide-tier Horizons sample caches. The default-window caches (chiron, the
# asteroids, the 1700-2200 Pluto) stay committed for reproducibility at a few
# MB each, but the wide spans are far larger -- 21 MB per small body at 1-day
# steps, 84 MB at 6-hour, 47 MB for Pluto over 1000-3000, ~430 MB in total --
# and are re-derivable from Horizons by re-running the fit scripts. The packs
# they produce ARE committed, which is what consumers and the goldens need.
python/*_horizons_cache_[0-9]*.json
# The classical-era caches are wider still (~1.4 GB for all seven bodies, the
# Moon alone ~800 MB at 3-hour steps over 3000 BCE-1000 CE). Same rationale:
# re-derivable by re-running fit_classical.py; the minted slabs are committed.
python/*_horizons_cache_classical*.json
# In-progress download checkpoints (HorizonsCache resume support). Pure scratch.
python/*.part
# npm pack dry-run tarballs from release prep; `npm publish` packs fresh.
packages/*/caelus-*.tgz
.vercel
