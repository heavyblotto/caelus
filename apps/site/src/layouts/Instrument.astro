---
/**
 * Shell for the instrument pages: the Astro counterpart of the Next route
 * group under apps/web/app/instruments. The whole site follows the Workbench
 * grammar now, so an instrument needs nothing beyond the root document; the
 * layout stays so the instrument pages keep one place to grow from.
 */
import Base from "./Base.astro";

interface Props {
  meta?: object;
}
---

<Base meta={Astro.props.meta}><slot /></Base>
